rules_version = '2';

// Single-user app: only the owner's account can read or write, and only under
// its own users/{uid} path. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    // Firebase UID of the owner. Not a secret: the Firebase web config is public by
    // design, security comes from these rules. Rules cannot read environment variables.
    function ownerUid() {
      return 'u4M1aUap8OWaCln0bdZlqDTHQ0a2';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && uid == ownerUid();
    }

    function hasLanguages(translations) {
      return translations is map
        && translations.keys().hasAll(['fr', 'en', 'es', 'it'])
        && translations.keys().hasOnly(['fr', 'en', 'es', 'it'])
        && translations.fr is list && translations.fr.size() > 0
        && translations.en is list && translations.en.size() > 0
        && translations.es is list && translations.es.size() > 0
        && translations.it is list && translations.it.size() > 0;
    }

    // Structural checks only: the full schema is validated client-side with Zod.
    function isValidEntry(data) {
      let fields = ['schemaVersion', 'type', 'translations', 'mastered', 'createdAt', 'updatedAt', 'deleted'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.schemaVersion is int && data.schemaVersion >= 1
        && data.type in ['word', 'verb']
        && hasLanguages(data.translations)
        && data.mastered is bool
        && data.deleted is bool
        && data.createdAt is timestamp && data.createdAt <= request.time
        // Server timestamp only: the delta sync relies on it, a client clock could be wrong.
        && data.updatedAt == request.time;
    }

    match /users/{uid}/entries/{entryId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidEntry(request.resource.data);
      allow update: if isOwner(uid)
        && isValidEntry(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      // Hard deletes would never reach other devices through the delta sync:
      // deletions are soft (`deleted: true`).
      allow delete: if false;
    }
  }
}
