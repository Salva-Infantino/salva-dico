# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are bundled into the client and are PUBLIC.

# --- Firebase web config (client, public by design; security relies on Firestore rules) ---
# Added in step 2.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (Netlify Functions). Set in Netlify environment variables. ---
# Added in step 6. Never prefix these with VITE_.
# Firebase UID of the only user allowed to call the AI function.
OWNER_UID=
# Google Gemini API key. Must never reach the client.
GEMINI_API_KEY=
# Gemini model name, e.g. a current free-tier model (check the Gemini docs).
GEMINI_MODEL=
