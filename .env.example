# Copy to .env.local for local development. Never commit real values.
# Variables prefixed with VITE_ are bundled into the client and are PUBLIC.

# --- Firebase web config (client, public by design; security relies on Firestore rules) ---
# From Firebase console > Project settings > Your apps > Web app.
# Locally, keep authDomain = <project>.firebaseapp.com (popup sign-in).
# On Netlify, set it to the site's own domain (redirect sign-in through the /__/auth proxy).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Server only (Netlify Functions). Set in Netlify environment variables. ---
# Locally, the Vite dev server reads them from .env.local for /api/translate.
# Never prefix these with VITE_: they must never reach the client bundle.
# Firebase UID of the only user allowed to call the AI function.
OWNER_UID=
# Google Gemini API key. Must never reach the client.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models, tried in order when one is out of quota or overloaded
# (default gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash).
# Check the free-tier models in the Gemini docs.
GEMINI_MODEL=
# Optional: defaults to VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
