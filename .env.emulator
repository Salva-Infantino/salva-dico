# Loaded by `vite --mode emulator` (pnpm dev:emulators, E2E tests).
# Fake values for the local Firebase emulators only: committed on purpose, nothing secret.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-salva-dico.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-salva-dico
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
